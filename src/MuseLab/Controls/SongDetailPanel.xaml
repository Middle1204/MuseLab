<UserControl x:Class="MuseLab.Controls.SongDetailPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/MuseLab;component/Styles/SharedStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <Grid Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Song Detail"
                       FontSize="16"
                       Foreground="White"
                       VerticalAlignment="Center"/>

            <Button x:Name="CloseDetailButton"
                    Grid.Column="1"
                    Content="×"
                    Background="Transparent"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="20"
                    Width="24"
                    Height="24"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Cursor="Hand"
                    Click="CloseDetailButton_Click"/>
        </Grid>

        <!-- 콘텐츠 -->
        <ScrollViewer Grid.Row="1"
                      Style="{StaticResource CustomScrollViewerStyle}"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- 타이틀 -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="DetailTitle"
                                   Text="—"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>

                        <TextBlock x:Name="DetailComposer"
                                   Text="—"
                                   FontSize="13"
                                   Foreground="{StaticResource SubTextBrush}"
                                   Margin="0,0,0,10"/>

                        <!-- 난이도 / 레벨 배지 / 랭킹 -->
                        <Grid>
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Left">
                                <Border x:Name="DetailCourseBadge"
                                        Background="{StaticResource CourseDefaultBrush}"
                                        CornerRadius="5"
                                        Padding="8,4"
                                        Margin="0,0,6,0">
                                    <TextBlock x:Name="DetailCourse"
                                               Text="—"
                                               FontSize="12"
                                               Foreground="White"
                                               FontWeight="SemiBold"/>
                                </Border>

                                <Border Style="{StaticResource LevelBadgeStyle}"
                                        CornerRadius="5"
                                        Padding="8,4">
                                    <TextBlock FontSize="12"
                                               Foreground="White"
                                               FontWeight="SemiBold">
                                        <Run Text="Lv. "/>
                                        <Run x:Name="DetailLevel" Text="—"/>
                                    </TextBlock>
                                </Border>
                            </StackPanel>

                            <Button x:Name="RankingButton"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="#FF2D2D2D"
                                    Foreground="#FFBBBBBB"
                                    BorderBrush="#FF555555"
                                    BorderThickness="1"
                                    Padding="8,4"
                                    FontSize="11"
                                    Cursor="Hand"
                                    ToolTip="랭킹 보기(미구현)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#x1F3C6;"
                                               FontSize="11"
                                               Margin="0,0,4,0"
                                               VerticalAlignment="Center"/>
                                    <TextBlock Text="랭킹 보기"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 기본 상세 (Notes / BPM / Length) -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Notes" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DetailNotes" Text="—" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="BPM" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DetailBpm" Text="—" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Length" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,2"/>
                            <TextBlock x:Name="DetailLength" Text="—" FontSize="18" FontWeight="Bold" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 패키지 / 출시일 -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="Package" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="DetailPackage" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="Release Date" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,3"/>
                            <TextBlock x:Name="DetailReleaseDate" Text="—" FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 점수조합 -->
                <Border Style="{StaticResource DetailCardStyle}">
                    <StackPanel>
                        <TextBlock Text="Character / Pet" FontSize="13" Foreground="White" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Character" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,3"/>
                                <TextBlock x:Name="DetailCharacter" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Pet" FontSize="11" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,0,3"/>
                                <TextBlock x:Name="DetailPet" Text="—" FontSize="13" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 히든 해금 방법 -->
                <Border x:Name="HiddenUnlockSection"
                        Background="#33772288"
                        BorderBrush="#FF9B59B6"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14"
                        Margin="0,0,0,10"
                        Visibility="Collapsed">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="🔓"
                                       FontSize="13"
                                       Margin="0,0,6,0"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Hidden Unlock"
                                       FontSize="13"
                                       Foreground="#FFCE9CFF"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock x:Name="DetailHiddenUnlock"
                                   Text="—"
                                   FontSize="13"
                                   Foreground="White"
                                   TextWrapping="Wrap"
                                   LineHeight="20"/>
                    </StackPanel>
                </Border>

                <!-- 정확도 -->
                <Border Style="{StaticResource DetailCardStyle}" Margin="0">
                    <StackPanel>
                        <TextBlock Text="Best Accuracy  (Dummy)"
                                   FontSize="13"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,12"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock x:Name="AccuracyLabel"
                                           Text="—"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </StackPanel>

                            <Border Grid.Column="1"
                                    x:Name="AccuracyRankBadge"
                                    Background="#FF2D9CDB"
                                    CornerRadius="8"
                                    Padding="12,6"
                                    VerticalAlignment="Center">
                                <TextBlock x:Name="AccuracyRank"
                                           Text="—"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="White"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
